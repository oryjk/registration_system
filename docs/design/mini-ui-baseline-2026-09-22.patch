index 0000000..c2eee13
--- /dev/null
+++ b/registration_system_mini/src/pages/home/components/HomeActionMatchDeck.vue
@@ -0,0 +1,190 @@
+<script setup lang="ts">
+import { computed, onUnmounted, ref } from "vue";
+import { resolveDeckSwipe, deckBoundaryMessage, resolveDeckAxis, deckDragOffset } from '../homeActionDeckState';
+const props = defineProps<{ index: number; count: number }>();
+const emit = defineEmits<{
+  (event: 'change', index: number): void;
+  (event: 'interaction', blocked: boolean): void;
+}>();
+type Point = { clientX: number; clientY: number };
+const offset = ref(0);
+const dragging = ref(false);
+// 背层过渡只跟手指：换血瞬间 dragging 会短暂置真让主卡瞬移复位，背层回落必须保持动画，不能一并关掉过渡。
+const fingerDragging = ref(false);
+const settling = ref(false);
+// 落定入场弹跳（deck-land）与失败回弹摆动（deck-front--rebound）的开关。
+const landing = ref(false);
+const rebounding = ref(false);
+// 边界方向的拖动（该方向已无相邻比赛）：背层实卡淡出，避免把另一侧的比赛误露成“这个方向还有卡”。
+const overDrag = ref(false);
+const revealPrevious = computed(() => props.index === props.count - 1 || (offset.value > 0 && props.index > 0));
+// 内联样式里的 rpx 在 H5 不会换算，浏览器按非法单位丢弃整条 transform；统一换算成 px（小程序上与 rpx 等价）。
+const deckLiftPx = uni.upx2px(14);
+const underStyle = computed(() => {
+  const progress = Math.min(1, Math.abs(offset.value) / 140);
+  return { transform: `translateY(${deckLiftPx * (1 - progress)}px) rotate(${1 - progress}deg) scale(${0.98 + 0.02 * progress})` };
+});
+const frontStyle = computed(() => ({
+  transform: `translate3d(${offset.value}px, 0, 0) rotate(${Math.max(-6, Math.min(6, offset.value / 35))}deg)`,
+  opacity: settling.value && Math.abs(offset.value) > 200 ? 0 : 1,
+}));
+let origin: Point | null = null;
+let axis: 'pending' | 'horizontal' | 'vertical' = 'pending';
+let timer: ReturnType<typeof setTimeout> | undefined;
+let landingTimer: ReturnType<typeof setTimeout> | undefined;
+let lastBoundaryToastAt = 0;
+// 入场弹跳会让 keyframe 动画接管 transform，新手势或新切换开始时必须立即取消。
+function cancelLanding() {
+  landing.value = false;
+  if (landingTimer) clearTimeout(landingTimer);
+}
+function release() {
+  offset.value = 0;
+  dragging.value = false;
+  fingerDragging.value = false;
+  overDrag.value = false;
+  settling.value = false;
+  rebounding.value = false;
+  emit('interaction', false);
+}
+function rebound() {
+  fingerDragging.value = false;
+  overDrag.value = false;
+  cancelLanding();
+  dragging.value = false;
+  settling.value = true;
+  rebounding.value = true;
+  offset.value = 0;
+  timer = setTimeout(release, 330);
+}
+function change(step: number) {
+  if (settling.value || !props.count || !step) return;
+  emit('interaction', true);
+  fingerDragging.value = false;
+  overDrag.value = false;
+  cancelLanding();
+  const message = deckBoundaryMessage(props.index, props.count, step);
+  if (message) {
+    const now = Date.now();
+    if (now - lastBoundaryToastAt >= 1600) {
+      lastBoundaryToastAt = now;
+      uni.showToast({ title: message, icon: 'none', duration: 1500 });
+    }
+    rebound();
+    return;
+  }
+  const next = props.index + step;
+  dragging.value = false;
+  settling.value = true;
+  offset.value = -step * uni.getWindowInfo().windowWidth;
+  timer = setTimeout(() => {
+    // 新卡从牌堆原位露出，避免把新内容从离场位置拖回。
+    settling.value = false;
+    dragging.value = true;
+    offset.value = 0;
+    emit('change', Math.max(0, Math.min(next, props.count - 1)));
+    landing.value = true;
+    landingTimer = setTimeout(() => { landing.value = false; }, 420);
+    timer = setTimeout(release, 60);
+  }, 220);
+}
+function start(event: { touches: ArrayLike<Point> }) {
+  if (settling.value || dragging.value || event.touches.length !== 1) return;
+  cancelLanding();
+  const point = event.touches[0];
+  origin = point ? { clientX: point.clientX, clientY: point.clientY } : null;
+  axis = 'pending';
+}
+function move(event: { touches: ArrayLike<Point> }) {
+  if (!origin) return;
+  if (event.touches.length !== 1) { cancel(); return; }
+  const point = event.touches[0];
+  if (!point) return;
+  const dx = point.clientX - origin.clientX;
+  const dy = point.clientY - origin.clientY;
+  if (axis === 'pending') axis = resolveDeckAxis(dx, dy);
+  if (axis !== 'horizontal') return;
+  if (!dragging.value) emit('interaction', true);
+  dragging.value = true;
+  fingerDragging.value = true;
+  overDrag.value = !!deckBoundaryMessage(props.index, props.count, dx < 0 ? 1 : -1);
+  offset.value = deckDragOffset(dx, props.index, props.count);
+}
+function end(event: { changedTouches: ArrayLike<Point> }) {
+  if (!origin) return;
+  const point = event.changedTouches[0];
+  const dx = point ? point.clientX - origin.clientX : 0;
+  const dy = point ? point.clientY - origin.clientY : 0;
+  origin = null;
+  if (axis === 'vertical') return;
+  const step = resolveDeckSwipe(dx, dy);
+  if (step) change(step);
+  else if (dragging.value) rebound();
+}
+function cancel() {
+  origin = null;
+  if (dragging.value && !settling.value) rebound();
+}
+onUnmounted(() => {
+  if (timer) clearTimeout(timer);
+  if (landingTimer) clearTimeout(landingTimer);
+  emit('interaction', false);
+});
+</script>
+
+<template>
+  <view class="action-deck">
+    <view class="deck-control" @touchstart="start" @touchmove="move" @touchend="end" @touchcancel="cancel">
+      <view class="deck-caption">
+        <text class="deck-title">最近要处理</text>
+        <text v-if="count > 1" class="deck-position">{{ index + 1 }} / {{ count }}</text>
+      </view>
+      <view v-if="count > 1" class="deck-actions">
+        <button aria-label="上一场比赛" :disabled="index === 0 || settling || dragging" @tap.stop="change(-1)">←</button>
+        <button aria-label="下一场比赛" :disabled="index === count - 1 || settling || dragging" @tap.stop="change(1)">→</button>
+      </view>
+    </view>
+    <view class="deck-stack" :class="{ 'deck-stack--multiple': count > 1 }">
+      <view v-if="count > 2" class="deck-back deck-back--far" />
+      <view v-if="count > 1" class="deck-under" :class="{ 'deck-under--dragging': fingerDragging, 'deck-under--empty': overDrag }" :style="underStyle" aria-hidden="true" inert>
+        <view v-show="revealPrevious"><slot name="previous" /></view>
+        <view v-show="!revealPrevious"><slot name="next" /></view>
+      </view>
+      <view class="deck-front" :class="{ 'deck-front--dragging': dragging, 'deck-front--settling': settling, 'deck-front--landing': landing, 'deck-front--rebound': rebounding }" :style="frontStyle" @touchstart="start" @touchmove="move" @touchend="end" @touchcancel="cancel"><slot /></view>
+    </view>
+  </view>
+</template>
+
+<style scoped>
+.action-deck { margin-top: 18rpx; overflow: hidden; padding: 0 4rpx; }
+.deck-control { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 12rpx 6rpx; touch-action: pan-y; }
+.deck-caption { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
+.deck-title { font-size: 28rpx; font-weight: 600; color: var(--now-color-text); }
+.deck-position { font-size: 22rpx; color: var(--now-color-muted); }
+.deck-actions { display: flex; gap: 12rpx; }
+.deck-actions button { margin: 0; padding: 0; width: 64rpx; height: 64rpx; line-height: 64rpx; border-radius: 50%; background: var(--now-color-soft); color: var(--now-color-accent-text); font-size: 30rpx; }
+.deck-actions button::after { border: 0; }
+.deck-actions button[disabled] { opacity: 0.3; }
+.deck-stack { position: relative; }
+.deck-stack--multiple { padding: 0 8rpx 38rpx; }
+.deck-back { position: absolute; inset: 18rpx 8rpx 38rpx; border: var(--now-border); border-radius: var(--now-radius-card); background: var(--now-deck-near); box-shadow: var(--now-shadow); pointer-events: none; transform-origin: center bottom; }
+.deck-back--far { transform: translate(8rpx, 26rpx) rotate(2deg) scale(0.96); background: var(--now-deck-far); }
+.deck-back--near { transform: translate(4rpx, 14rpx) rotate(1deg) scale(0.98); }
+.deck-under { position: absolute; top: 0; left: 8rpx; right: 8rpx; bottom: 38rpx; overflow: hidden; border-radius: var(--now-radius-card); pointer-events: none; transform-origin: center bottom; transition: transform 300ms cubic-bezier(0.34, 1.4, 0.5, 1), opacity 180ms ease; }
+/* 手指拖动时背层 transform 必须跟手；边界拖动反向拖回时实卡平滑淡入。 */
+.deck-under--dragging { transition: opacity 180ms ease; }
+/* 边界方向的拖动：实卡必须与主卡位移同帧隐藏（快速轻扫时淡出会先露出内容）；淡入走上面的过渡。 */
+.deck-under--empty { transition: none; opacity: 0; }
+.deck-front { position: relative; transform-origin: bottom center; transition: transform 220ms cubic-bezier(0.2, 0.7, 0.3, 1), opacity 220ms ease; }
+.deck-front--dragging { transition: none; }
+.deck-front--settling { pointer-events: none; }
+/* 失败回弹：从松手位置摆回原点并轻微过冲，像皮筋拉回；出牌动画仍用上方 220ms 不带过冲。 */
+.deck-front--rebound { transition: transform 300ms cubic-bezier(0.34, 1.5, 0.64, 1), opacity 220ms ease; }
+/* 新卡落定弹跳：从牌堆里的小一码弹到轻微过冲再回正；动画期间 transform 由 keyframe 接管。 */
+.deck-front--landing { animation: deck-land 360ms cubic-bezier(0.25, 0.8, 0.35, 1); }
+@keyframes deck-land {
+  0% { transform: translateY(10rpx) scale(0.955); }
+  58% { transform: translateY(-4rpx) scale(1.02); }
+  100% { transform: translateY(0) scale(1); }
+}
+</style>
