+  background: var(--neo-color-text);
+  border-radius: 2rpx;
+  transform: rotate(45deg);
+  transform-origin: right center;
+}
+
+.home-header-search__row {
+  display: flex;
+  align-items: center;
+  gap: 16rpx;
+  width: 100%;
+  min-width: 0;
+}
+
+.home-header-search__bar {
+  display: flex;
+  align-items: center;
+  gap: 12rpx;
