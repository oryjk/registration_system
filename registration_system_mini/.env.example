# Complete Go app API root. Domain clients append paths such as /users/me.
VITE_API_BASE_URL=http://127.0.0.1:18080/api/v1/app

# Keep mock enabled for UI-only development; disable it to call the Go API.
VITE_USE_MOCK=true

# Development-only H5 account selector backed by Go test-auth routes.
VITE_ENABLE_H5_TEST_LOGIN=true
