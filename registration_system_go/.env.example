HTTP_ADDR=:18080
DATABASE_URL=postgres://betalpha:<password>@127.0.0.1:5432/registration_system_go?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
APP_ENV=production
ENABLE_H5_TEST_LOGIN=false
H5_TEST_DEFAULT_USER_ID=37
WECHAT_PAY_USE_MOCK=false
WECHAT_PAY_MCH_ID=replace-with-wechat-pay-merchant-id
WECHAT_PAY_API_KEY=replace-with-wechat-pay-v2-api-key
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
PUBLIC_BASE_URL=https://api.example.com
WECHAT_PAY_NOTIFY_PATH=/api/v1/webhooks/wechat-pay
# 用户上传文件（头像）本地存储目录，通过 /uploads 静态路径对外服务；PUBLIC_BASE_URL 非空时头像 URL 以其为前缀。
UPLOAD_DIR=uploads
# Optional isolated integration-test database. Never use development or production data.
TEST_DATABASE_URL=
LEGACY_MYSQL_HOST=replace-with-legacy-mysql-host
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=replace-with-legacy-mysql-user
LEGACY_MYSQL_PASSWORD=replace-with-legacy-mysql-password
LEGACY_MYSQL_DATABASE=registration_system
LEGACY_PG_URL=postgres://replace-with-user:replace-with-password@replace-with-host:5432/registration_system?sslmode=disable
