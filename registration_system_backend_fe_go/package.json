{
  "name": "registration_system_backend_fe_go",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "cross-env ADMIN_API_BASE_URL=/go-api vite --host 0.0.0.0",
    "build": "cross-env ADMIN_PUBLIC_PATH=/ ADMIN_ROUTE_BASE=/ vite build",
    "build:nginx": "cross-env ADMIN_PUBLIC_PATH=/registration-admin/ ADMIN_ROUTE_BASE=/registration-admin/ vite build",
    "build:out109": "cross-env ADMIN_PUBLIC_PATH=/regist-admin-v3/ ADMIN_ROUTE_BASE=/regist-admin-v3/ ADMIN_API_BASE_URL=https://oryjk.cn:82/regist-v3 vite build",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "cross-env ADMIN_API_BASE_URL=/go-api vitest run",
    "test:performance": "node --test scripts/*.test.mjs",
    "perf:budget": "node scripts/entry-budget.mjs --max-gzip 220000",
    "perf:measure": "node scripts/measure-login-performance.mjs",
    "test:e2e": "cross-env PORT=5175 playwright test",
    "test:e2e:nginx": "bun run build:nginx && cross-env PORT=5185 PLAYWRIGHT_DIST_BASE=/registration-admin/ PLAYWRIGHT_BASE_URL=http://127.0.0.1:5185/registration-admin/ playwright test e2e/admin-routing.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.100.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.20",
    "lucide-react": "^0.561.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.5",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.64.0",
    "react-router": "^7.9.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.0",
    "vitest": "^4"
  }
